# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/movie-streaming

# NextAuth
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Admin login credentials (single-admin setup — change these!)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash

# Vercel Blob storage — where uploaded video files are stored.
# Create a Blob store in your Vercel project dashboard (Storage tab),
# then it auto-fills this token when linked to your project. For local
# dev, copy the token from Vercel dashboard → Storage → your store → .env.local tab.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx
